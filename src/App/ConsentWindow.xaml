<Window x:Class="PomocZdalna.App.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prośba o dostęp zdalny" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize" ShowInTaskbar="True">
    <StackPanel Margin="20">
        <TextBlock x:Name="Question" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Margin="0,8,0,14" TextWrapping="Wrap" Foreground="#4B5563"
                   Text="Technik zobaczy Twój ekran. Wybierz, na co mu pozwalasz. Sesję możesz zakończyć w każdej chwili."/>
        <CheckBox x:Name="ControlCheck" Content="Zezwól na sterowanie myszą i klawiaturą" IsChecked="True" Margin="0,0,0,6"/>
        <CheckBox x:Name="CommandsCheck" Content="Zezwól na wykonywanie poleceń (PowerShell / cmd)" Margin="0,0,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Odmów" Click="Deny_Click" IsCancel="True"/>
            <Button Content="Zezwól" Click="Allow_Click" IsDefault="True" Margin="0"/>
        </StackPanel>
    </StackPanel>
</Window>
